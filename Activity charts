"""
Generates a full-year GitHub contribution activity panel: a smoothed line
trend, a daily volume bar chart, and a pie breakdown of contribution types
(commits / issues / PRs / reviews). Built from real data pulled straight from
GitHub's GraphQL API, rendered locally, so it never depends on a third-party
widget service staying online.

Requires: requests, matplotlib
Env vars: GH_TOKEN (a token with read access), GH_USERNAME
"""

import os
from datetime import datetime, timedelta, timezone

import requests
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.dates as mdates

GH_TOKEN = os.environ["GH_TOKEN"]
GH_USERNAME = os.environ["GH_USERNAME"]

BG_COLOR = "#0D1117"
GRID_COLOR = "#21262D"
TEXT_COLOR = "#C9D1D9"
CYAN = "#00D9FF"
PURPLE = "#7928CA"
PINK = "#F72585"


def fetch_year_of_contributions():
    now = datetime.now(timezone.utc)
    start = now - timedelta(days=365)

    query = """
    query($login: String!, $from: DateTime!, $to: DateTime!) {
      user(login: $login) {
        contributionsCollection(from: $from, to: $to) {
          totalCommitContributions
          totalIssueContributions
          totalPullRequestContributions
          totalPullRequestReviewContributions
          contributionCalendar {
            weeks {
              contributionDays {
                date
                contributionCount
              }
            }
          }
        }
      }
    }
    """
    variables = {
        "login": GH_USERNAME,
        "from": start.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "to": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    resp = requests.post(
        "https://api.github.com/graphql",
        json={"query": query, "variables": variables},
        headers={
            "Authorization": f"bearer {GH_TOKEN}",
            "Accept": "application/vnd.github+json",
        },
        timeout=30,
    )
    resp.raise_for_status()
    payload = resp.json()
    if "errors" in payload:
        raise RuntimeError(payload["errors"])
    return payload["data"]["user"]["contributionsCollection"]


def rolling_average(values, window=7):
    out = []
    for i in range(len(values)):
        lo = max(0, i - window + 1)
        chunk = values[lo:i + 1]
        out.append(sum(chunk) / len(chunk))
    return out


def style_axes(ax):
    ax.set_facecolor(BG_COLOR)
    for spine in ax.spines.values():
        spine.set_color(GRID_COLOR)
    ax.tick_params(colors=TEXT_COLOR, labelsize=8)
    ax.grid(True, color=GRID_COLOR, linewidth=0.6, alpha=0.6)
    ax.title.set_color(TEXT_COLOR)


def main():
    data = fetch_year_of_contributions()

    dates, counts = [], []
    for week in data["contributionCalendar"]["weeks"]:
        for day in week["contributionDays"]:
            dates.append(datetime.strptime(day["date"], "%Y-%m-%d"))
            counts.append(day["contributionCount"])

    fig, axes = plt.subplots(1, 3, figsize=(18, 5), dpi=150)
    fig.patch.set_facecolor(BG_COLOR)

    # --- Line chart: smoothed trend over the year ---
    ax1 = axes[0]
    smoothed = rolling_average(counts, window=7)
    ax1.plot(dates, smoothed, color=CYAN, linewidth=2)
    ax1.fill_between(dates, smoothed, color=CYAN, alpha=0.15)
    ax1.xaxis.set_major_locator(mdates.MonthLocator(interval=2))
    ax1.xaxis.set_major_formatter(mdates.DateFormatter("%b"))
    ax1.set_title("7-Day Rolling Trend", fontsize=11, pad=10)
    style_axes(ax1)

    # --- Bar chart: daily contribution volume ---
    ax2 = axes[1]
    ax2.bar(dates, counts, color=PURPLE, width=1.0, linewidth=0)
    ax2.xaxis.set_major_locator(mdates.MonthLocator(interval=2))
    ax2.xaxis.set_major_formatter(mdates.DateFormatter("%b"))
    ax2.set_title("Daily Contribution Volume", fontsize=11, pad=10)
    style_axes(ax2)

    # --- Pie chart: contribution type breakdown ---
    ax3 = axes[2]
    labels_values = [
        ("Commits", data["totalCommitContributions"]),
        ("Issues", data["totalIssueContributions"]),
        ("Pull Requests", data["totalPullRequestContributions"]),
        ("PR Reviews", data["totalPullRequestReviewContributions"]),
    ]
    labels_values = [(l, v) for l, v in labels_values if v > 0]
    if labels_values:
        labels = [l for l, v in labels_values]
        values = [v for l, v in labels_values]
        colors = [CYAN, PURPLE, PINK, "#3FB950"][: len(values)]
        wedges, _, autotexts = ax3.pie(
            values,
            labels=labels,
            colors=colors,
            autopct="%1.0f%%",
            textprops={"color": TEXT_COLOR, "fontsize": 9},
            wedgeprops={"edgecolor": BG_COLOR, "linewidth": 2},
        )
        for at in autotexts:
            at.set_color(BG_COLOR)
            at.set_fontweight("bold")
    else:
        ax3.text(0.5, 0.5, "No contributions yet", color=TEXT_COLOR,
                  ha="center", va="center")
    ax3.set_title("Contribution Type Breakdown", fontsize=11, pad=10, color=TEXT_COLOR)
    ax3.set_facecolor(BG_COLOR)

    plt.tight_layout()
    os.makedirs("assets", exist_ok=True)
    fig.savefig("assets/activity-charts.png", facecolor=BG_COLOR, bbox_inches="tight")
    print("Generated assets/activity-charts.png")


if __name__ == "__main__":
    main()
